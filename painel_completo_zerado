        body.dark th,body.dark tr:hover,body.dark .table-toolbar,body.dark .calendar-header,body.dark .cat-chip,body.dark .cal-day:hover { background:#2a3548; color:var(--text-main); }
        body.dark .clickable-row:hover { background:#35425b !important; }
