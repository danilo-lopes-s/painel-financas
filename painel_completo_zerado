        window.renderEvolution = () => {
            const selector=document.getElementById('evoPeriod'), custom=selector.value==='personalizado';
            const fields=document.getElementById('evoCustomDates');fields.hidden=!custom;
            let inicio, fim;
            if(custom) {
                const start=document.getElementById('evoStart'),end=document.getElementById('evoEnd');
                if(!start.value) {let dt=new Date(globalAno,globalMes-5,1);start.value=`${dt.getFullYear()}-${String(dt.getMonth()+1).padStart(2,'0')}-01`;}
                if(!end.value) end.value=`${globalAno}-${String(globalMes+1).padStart(2,'0')}-${String(new Date(globalAno,globalMes+1,0).getDate()).padStart(2,'0')}`;
                inicio=start.value;fim=end.value;
            } else {
                let qtd=Number(selector.value)||6;
                const primeira=new Date(globalAno,globalMes-qtd+1,1),ultima=new Date(globalAno,globalMes+1,0);
                const iso=d=>`${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`;
                inicio=iso(primeira);fim=iso(ultima);
            }
            const svg=document.getElementById('evolutionSvg');
            if(!/^\d{4}-\d{2}-\d{2}$/.test(inicio)||!/^\d{4}-\d{2}-\d{2}$/.test(fim)||inicio>fim) {
                svg.innerHTML='<text x="30" y="90" fill="#e25555" font-size="16">Informe uma data inicial anterior ou igual à data final.</text>';
                document.getElementById('evolutionLegend').innerHTML='';return;
            }
            const [ai,mi]=inicio.split('-').map(Number),[af,mf]=fim.split('-').map(Number);
            const meses=[];
            for(let a=ai,m=mi,i=0;(a<af||(a===af&&m<=mf))&&i<240;i++) {
                const ym=`${a}-${String(m).padStart(2,'0')}`;
                meses.push({ym,label:`${M_SHORT[m-1]}/${String(a).slice(-2)}`,rec:[],des:[]});
                if(++m>12){m=1;a++}
            }
            if(!meses.length){svg.innerHTML='';return;}
            const indice=Object.fromEntries(meses.map((item,i)=>[item.ym,i]));
            dados.recebimentos.forEach(x=>{if(x.data>=inicio&&x.data<=fim&&indice[x.data.slice(0,7)]!==undefined) meses[indice[x.data.slice(0,7)]].rec.push(x)});
            dados.despesas.forEach(x=>{if(x.data>=inicio&&x.data<=fim&&indice[x.data.slice(0,7)]!==undefined) meses[indice[x.data.slice(0,7)]].des.push(x)});
            let series=[];
            if(metric==='fluxo') series=[{n:'Entradas',c:'#22a06b',v:meses.map(x=>sum(x.rec))},{n:'Saídas',c:'#e25555',v:meses.map(x=>sum(x.des))}];
            else {let parcial=0;series=[{n:'Progressão do Saldo',c:'#667eea',v:meses.map(x=>parcial+=sum(x.rec)-sum(x.des))}]}
            const valores=series.flatMap(x=>x.v), ymax=Math.max(1,...valores,0),ymin=Math.min(0,...valores), amplitude=ymax-ymin||1;
            const minX=60,maxX=870,x=i=>meses.length===1?(minX+maxX)/2:minX+i*(maxX-minX)/(meses.length-1);
            const y=v=>20+(ymax-v)/amplitude*160;
            let grid='';for(let i=0;i<=4;i++){let v=ymax-i*amplitude/4,yy=20+i*40;grid+=`<line x1="${minX}" y1="${yy}" x2="${maxX}" y2="${yy}" stroke="var(--line)"/><text x="0" y="${yy+3}" font-size="10" fill="var(--muted)">${money(v).replace('R$ ','').replace('R$ ','')}</text>`}
            const linhas=series.map(s=>`<polyline points="${s.v.map((v,i)=>`${x(i)},${y(v)}`).join(' ')}" fill="none" stroke="${s.c}" stroke-width="3" stroke-linejoin="round"/>${s.v.map((v,i)=>`<circle cx="${x(i)}" cy="${y(v)}" r="3" fill="${s.c}"><title>${s.n}: ${money(v)} — ${meses[i].label}</title></circle>`).join('')}`).join('');
            const step=Math.max(1,Math.ceil(meses.length/12));
            const labels=meses.map((m,i)=>i%step===0||i===meses.length-1?`<text x="${x(i)}" y="215" text-anchor="middle" font-size="11" fill="var(--muted)">${m.label.toUpperCase()}</text>`:'').join('');
            svg.innerHTML=grid+linhas+labels;
            document.getElementById('evolutionLegend').innerHTML=series.map(s=>`<span><i class="legend-dot" style="background:${s.c}"></i> ${s.n}</span>`).join('');
        };

