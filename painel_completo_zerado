                    <div class="ctx-kpi kpi-action" role="button" tabindex="0" title="Ver lançamentos, datas e valores" onclick="selecionarVisao('detalhe_resumo','saldo')" onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();this.click()}"><small>Saldo do Período</small><strong>R$&nbsp;0,00</strong></div>
