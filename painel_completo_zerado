    <div id="despesaModal" class="modal" onclick="if(event.target===this) closeModal('despesaModal')"><div class="modal-content"><div class="modal-header"><h2 id="tituloModalDespesa">📤 Nova Despesa</h2><button class="modal-close" onclick="closeModal('despesaModal')">✕</button></div><input type="hidden" id="despesaIdEdicao"><div class="form-group"><label>Título</label><input type="text" id="despesaTitulo" placeholder="O que você pagou?"></div><div class="form-row"><div class="form-group"><label>Valor</label><input type="number" id="despesaValor" step="0.01"></div><div class="form-group"><label>Data</label><input type="date" id="despesaData"></div></div><div class="form-group"><label>Categoria</label><select id="despesaCategoria"></select></div><div class="form-group"><label>Origem/Pagamento</label><select id="despesaOrigem"></select></div><div class="form-row" id="despesaFrequenciaBox" style="background:#f7fafc;padding:10px;border-radius:8px;margin-bottom:15px;"><div class="form-group" style="margin-bottom:0;"><label>Repetição</label><select id="despesaFrequencia" onchange="atualizarCamposRecorrencia('despesa')"><option value="unica">Única vez</option><option value="semanal">Semanal</option><option value="quinzenal">Quinzenal</option><option value="mensal">Mensal</option><option value="anual">Anual</option></select></div><div class="form-group" id="grupoDespesaVezes" style="display:none;margin-bottom:0;"><label>Vezes</label><input type="number" id="despesaVezes" min="1" max="600" value="2"></div></div><div class="form-group" id="despesaEdicaoEscopo" hidden=""><label>Aplicar alterações</label><select id="despesaEscopo" onchange="alterarEscopoRecorrencia('despesas')"><option value="serie">Toda a série (inclusive quantidade)</option><option value="unica">Somente esta ocorrência</option></select></div><div class="form-group" id="despesaParcelasBox"><label>Parcelas no Cartão</label><input type="number" id="despesaParcelas" min="1" value="1"></div><button class="btn btn-primary" id="btnSalvarDespesa" onclick="salvarDespesa()">Salvar</button></div></div>
