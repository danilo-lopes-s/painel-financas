        // Histórico independente da evolução de caixa; cotações históricas não são supostas.
        let invHistoricoPeriodo='6', invHistoricoInicio='', invHistoricoFim='';
        function invSerieHistorica() {
            const hoje=today(), dHoje=new Date(hoje+'T12:00:00');
            let inicio,fim=hoje;
            if(invHistoricoPeriodo==='personalizado') {
                const inicioPadrao=new Date(dHoje.getFullYear(),dHoje.getMonth()-5,1);
                inicio=invHistoricoInicio||`${inicioPadrao.getFullYear()}-${String(inicioPadrao.getMonth()+1).padStart(2,'0')}-01`;
                fim=invHistoricoFim||hoje;
            }else{
                const q=Math.max(1,Math.min(60,Number(invHistoricoPeriodo)||6));
                const di=new Date(dHoje.getFullYear(),dHoje.getMonth()-q+1,1);
                inicio=`${di.getFullYear()}-${String(di.getMonth()+1).padStart(2,'0')}-01`;
            }
            if(inicio>fim)return [];
            const limite=fim<hoje?fim:hoje, [ano,mes]=inicio.split('-').map(Number),[fimAno,fimMes]=limite.split('-').map(Number);
            const resultado=[];
            for(let y=ano,m=mes;nMes(y,m)<=nMes(fimAno,fimMes)&&resultado.length<60;){
                const mesFim=new Date(y,m,0);const mesFimIso=`${y}-${String(m).padStart(2,'0')}-${String(mesFim.getDate()).padStart(2,'0')}`;
                const alvo=mesFimIso>limite?limite:mesFimIso;
                let fixa=0,variavel=0;
                for(const i of dados.investimentos){
                    if(i.classe==='fixa') fixa+=aplicarFluxosFixos(i,alvo).saldo;
                    else {
                        const iTemp={...i,movimentos:i.movimentos.filter(x=>x.data<=alvo)};
                        const a=invAnalise(iTemp);
                        variavel+=a.valor;
                    }
                }
                resultado.push({mes:`${y}-${String(m).padStart(2,'0')}`,alvo,fixa,variavel,total:fixa+variavel});
                m++;if(m>12){m=1;y++;}
            }
            return resultado;
        }
        function nMes(y,m){return y*12+m;}
        function renderHistoricoInvestimentos(){
            const a=invSerieHistorica();
            const select=`<div class="inv-toolbar"><label style="margin:0;min-width:200px">Período da evolução<select id="invHistPeriodo" onchange="invHistoricoPeriodo=this.value;renderInvestimentos()"><option value="3" ${invHistoricoPeriodo==='3'?'selected':''}>Últimos 3 meses</option><option value="6" ${invHistoricoPeriodo==='6'?'selected':''}>Últimos 6 meses</option><option value="12" ${invHistoricoPeriodo==='12'?'selected':''}>Últimos 12 meses</option><option value="personalizado" ${invHistoricoPeriodo==='personalizado'?'selected':''}>Personalizado</option></select></label>${invHistoricoPeriodo==='personalizado'?`<label style="min-width:160px">Data inicial<input type="date" value="${esc(invHistoricoInicio)}" onchange="invHistoricoInicio=this.value;renderInvestimentos()"></label><label style="min-width:160px">Data final<input type="date" value="${esc(invHistoricoFim)}" onchange="invHistoricoFim=this.value;renderInvestimentos()"></label>`:''}</div>`;
