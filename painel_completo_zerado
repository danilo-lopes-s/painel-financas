                    <div class="card nav-card" draggable="false" data-view="categorias" onclick="selecionarVisao('categorias')"><div class="card-icon">🏷️</div><div class="card-title">Categorias</div><div class="card-value" id="totalCategorias">0</div><span class="nav-arrow">☰</span></div>
                    <div class="card nav-card" draggable="false" data-view="investimentos" onclick="selecionarVisao('investimentos')"><div class="card-icon">📈</div><div class="card-title">Investimentos</div><div class="card-value" id="totalInvestimentos">R$&nbsp;0,00</div><span class="nav-arrow">☰</span></div>
