        function initDragAndDrop() {
            const container = document.getElementById('navCards');
            let draggedItem = null;
            container.querySelectorAll('.nav-card').forEach(card => {
                const handle = card.querySelector('.nav-arrow');
                card.draggable = false;
                handle.addEventListener('mouseenter', () => { card.draggable = true; });
                handle.addEventListener('mouseleave', () => { if(draggedItem !== card) card.draggable = false; });
                handle.addEventListener('click', e => e.stopPropagation());
                card.addEventListener('dragstart', e => {
                    if (!card.draggable) { e.preventDefault(); return; }
                    draggedItem = card;
                    e.dataTransfer.effectAllowed = 'move';
                    e.dataTransfer.setData('text/plain',card.dataset.view);
                    setTimeout(() => card.classList.add('dragging'), 0);
                });
                card.addEventListener('dragend', () => {
                    card.classList.remove('dragging'); card.draggable = false;
                    if(draggedItem) { draggedItem = null; salvarOrdemCards(); }
                });
            });
            container.addEventListener('dragover', e => {
                if(!draggedItem) return;
                e.preventDefault();
                const afterElement = getDragAfterElement(container, e.clientY);
                if(afterElement == null) container.appendChild(draggedItem);
                else if(afterElement !== draggedItem) container.insertBefore(draggedItem, afterElement);
            });
        }

                function getDragAfterElement(container, y) {
            const draggableElements = [...container.querySelectorAll('.nav-card:not(.dragging)')];
            return draggableElements.reduce((closest, child) => {
                const box = child.getBoundingClientRect(); const offset = y - box.top - box.height / 2;
                if (offset < 0 && offset > closest.offset) return { offset: offset, element: child }; else return closest;
            }, { offset: Number.NEGATIVE_INFINITY }).element;
        }
        function salvarOrdemCards() {
            const order = [...document.querySelectorAll('#navCards .nav-card')].map(c => c.getAttribute('data-view'));
