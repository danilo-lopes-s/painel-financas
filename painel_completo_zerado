            const avisoLegado=resumoPagamentosNaoConciliados(nome);
            const geral=expBloco('cartoes:graficos:gerais',resumoCabecalho('📊 Visão geral dos cartões','Comparação de faturas e limites entre os cartões cadastrados.'),()=>graficoDaVisao('cartoes'),{aberto:false,classe:'conta-graficos-bloco'});
