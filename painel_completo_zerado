        (function configurarRetornoAoInicioEmListasLongas() {
            const raizes = Array.from(document.querySelectorAll('#contextContent, #quadroCorpo'));
            if (!raizes.length) return;

            const movimentoReduzido = () => window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
            const limiteAlturaLista = () => Math.max(280, Math.min(520, window.innerHeight * 0.48));
