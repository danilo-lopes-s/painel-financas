        window.confirmarPagamentoCartao=()=>{
            const p=pagamentoCartaoPendente;if(!p)return;
            const conta=document.getElementById('pagtoCartaoConta').value,data=document.getElementById('pagtoCartaoData').value;
            const ids=new Set([...document.querySelectorAll('#pagtoCartaoItens .pgto-check:checked')].map(e=>e.value));
            const itens=p.ids.filter(id=>ids.has(id)).map(id=>dados.despesas.find(x=>x.id===id)).filter(Boolean);
            const c=contaPeloNome(conta);
            if(!c)return showToast('Selecione uma conta de pagamento valida.',true);
            if(!/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/.test(data)||data>dataLocalPagamento())return showToast('Informe a data real do pagamento (nao pode ser futura).',true);
            if(!itens.length)return showToast('Selecione pelo menos um lancamento.',true);
            if(itens.some(x=>x.pagamentoCartao||!(x.origem||'').startsWith('cartao_')))return showToast('Os registros mudaram; abra o pagamento novamente.',true);
            const total=r2(sum(itens)),jaConsiderado=p.conciliacao&&document.getElementById('pagtoJaConsiderado').checked;
            if(total<=0)return showToast('Valor invalido para pagamento.',true);
            if(!jaConsiderado&&ivNum(c.saldo)-total<-.005&&!confirm(`A conta ${c.nome} tem ${money(c.saldo)}, mas o pagamento totaliza ${money(total)}. O saldo ficara negativo. Confirma?`))return;
            const msg=p.conciliacao?(jaConsiderado?`Marcar ${itens.length} pagamento(s) como ja considerados no saldo de ${c.nome}, SEM descontar novamente ${money(total)}?`:`Regularizar ${itens.length} pagamento(s) ja marcados como Pago, debitando ${money(total)} da conta ${c.nome}? Confirme SOMENTE se esses valores ainda nao foram descontados do saldo.`):
