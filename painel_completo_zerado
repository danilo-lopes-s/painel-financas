                            <div class="donut-hole" style="cursor:pointer" onclick="event.stopPropagation();selecionarVisao('detalhe_resumo','despesas')" title="Ver todas as despesas"><span>TOTAL</span><strong>R$&nbsp;0,00</strong></div>
                        </div>
                        <div style="width:100%;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:5px;font-size:.75em;margin-top:10px">
                            
                        </div>
                    </div>
                    <div class="ctx-box">
                        <h3>📈 Valores por Categoria</h3>
