        .cal-date { font-weight: bold; font-size: 0.85em; color: #4a5568; margin-bottom: 5px; }
        .cal-badge { font-size: 0.65em; padding: 2px 4px; border-radius: 4px; font-weight: bold; color: white; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; display:flex; justify-content:space-between;}
        .bdg-in { background: var(--ok); } .bdg-out { background: var(--bad); }

        .table-toolbar { display: flex; gap: 10px; margin-bottom: 15px; flex-wrap: wrap; background: #f8fafc; padding: 12px; border-radius: 8px; border: 1px solid var(--line); align-items: center; }
        .table-toolbar input, .table-toolbar select { flex: 1; min-width: 160px; padding: 9px; border: 1px solid #cbd5e0; border-radius: 6px; font-size: 0.9em; }

        .status-chip { padding: 4px 8px; border-radius: 99px; text-align: center; font-size: 0.7rem; font-weight: 800; display: inline-flex; align-items: center; gap: 4px; }
        .s-pago, .s-confirmado { background: #e6ffed; color: #237a3b; border: 1px solid #b7ebc6; }
        .s-vencido, .s-atrasado { background: #fff0f0; color: #b42318; border: 1px solid #fecaca; }
        .s-hoje { background: #ffedd5; color: #975a16; border: 1px solid #fbd38d; }
        .s-breve { background: #fefcbf; color: #975a16; border: 1px solid #f6e05e; }
        .s-futuro, .s-planejado { background: #ebf8ff; color: #2b6cb0; border: 1px solid #bee3f8; }
        .cat-chip { display: inline-flex; align-items: center; gap: 5px; padding: 3px 8px; border-radius: 6px; background: #f1f5f9; font-size: 0.75rem; font-weight: 600; border: 1px solid var(--line); }

        table { width: 100%; border-collapse: collapse; margin-top: 10px; font-size: 0.9em; }
        th, td { padding: 12px; text-align: left; border-bottom: 1px solid var(--line); }
        th { background: #f7fafc; font-weight: bold; color: #4a5568; border-top: 1px solid var(--line); }
        tr:hover { background: #f8fafc; } .clickable-row { cursor: pointer; transition: 0.2s; } .clickable-row:hover { background-color: #edf2f7 !important; }

        /* PAINEL INFERIOR RETORNADO (Evolução e Saldo) */
        .bottom-layout { display: grid; grid-template-columns: 285px minmax(0, 1fr); gap: 18px; margin-top: 18px; }
        .balance-card { background: linear-gradient(145deg, #fff, #f7f5ff); border: 2px solid #ded7ff; border-radius: 15px; padding: 18px; cursor: pointer; box-shadow: 0 8px 20px rgba(66, 51, 122, 0.1); transition: transform 0.3s; }
        .balance-card:hover { transform: translateY(-5px); }
        .balance-card h3 { color: #44337a; margin-bottom: 14px; font-size: 1.1em;}
