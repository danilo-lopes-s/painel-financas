        function restaurarOrdemCards() {
            if(!dados.navOrder || dados.navOrder.length === 0) return;
            const container = document.getElementById('navCards');
            dados.navOrder.forEach(view => {
                const el = container.querySelector(`.nav-card[data-view="${view}"]`);
                if(el) container.appendChild(el);
            });
            // Cards acrescentados em versões posteriores vão ao final, sem alterar a ordem salva.
            [...container.querySelectorAll('.nav-card')].filter(c=>!dados.navOrder.includes(c.dataset.view)).forEach(c=>container.appendChild(c));
        }

