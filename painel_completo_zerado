            let base=ivNum(i.taxaBase)/100, taxa=ivNum(i.taxaAnual)/100, pct=ivNum(i.percentualIndexador)/100, spread=ivNum(i.spread)/100;
            if(i.indexador==='CDI') return base*pct+spread;
