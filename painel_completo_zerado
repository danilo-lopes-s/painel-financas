            }
            const medio=qtd>0?custo/qtd:0, cot=ivNum(inv.cotacaoAtual), temCotacao=cot>0;
            return {qtd,custo,medio,valor:qtd*(temCotacao?cot:medio),principal:custo,resultado:qtd*(cot-medio),realizado,recebidos,temCotacao};
        }
