        let pagamentoCartaoPendente=null;
        const dataLocalPagamento=()=>{const d=new Date();return `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`;};
        const despesasCartaoSemConciliacao=(nome=null)=>dados.despesas.filter(x=>
            (x.origem||'').startsWith('cartao_') && (!nome||x.origem==='cartao_'+nome)
            && x.status==='Pago' && !x.pagamentoCartao);
        const despesasCartaoPagasNaConta=(nome)=>dados.despesas.filter(x=>x.pagamentoCartao && x.pagamentoCartao.conta===nome && x.status==='Pago');

        function estornarPagamentoCartao(x){
            if(!x?.pagamentoCartao)return true;
            const p=x.pagamentoCartao,c=contaPeloNome(p.conta);
            if(!c)return false;
            if(!p.jaConsiderado)definirSaldoConta(c,ivNum(c.saldo)+ivNum(p.valor));
            delete x.pagamentoCartao;
            return true;
        }
        function registrarPagamentoCartao(x,conta,data,idOperacao,jaConsiderado=false){
            if(x.pagamentoCartao)return false;
            if(!(x.origem||'').startsWith('cartao_'))return false;
            const c=contaPeloNome(conta),valor=r2(x.valor);
            if(!c||!['corrente','poupança','dinheiro'].includes(tipoConta(c))||!Number.isFinite(valor)||valor<=0||!/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/.test(data)||data>dataLocalPagamento())return false;
            if(!jaConsiderado)definirSaldoConta(c,ivNum(c.saldo)-valor);
            x.pagamentoCartao={conta:c.nome,valor,data,operacaoId:idOperacao||uid('pgto'),...(jaConsiderado?{jaConsiderado:true}:{})};
            x.status='Pago';
            return true;
        }
        function sincronizarPagamentosCartaoRegistrados(){
            // Somente registros que JA possuem comprovante financeiro sao ajustados.
            // Nunca converte automaticamente "Pago" legado em debito.
            let mudou=false;
            for(const x of dados.despesas){
                const p=x.pagamentoCartao;
                if(!p)continue;
                if(x.status!=='Pago'||!(x.origem||'').startsWith('cartao_')){
                    if(estornarPagamentoCartao(x))mudou=true;
                    continue;
                }
                if(p.jaConsiderado)continue;
                const c=contaPeloNome(p.conta),valor=r2(x.valor);
                if(!c||!Number.isFinite(valor)||valor<=0)continue;
                const diferenca=r2(valor-ivNum(p.valor));
                if(Math.abs(diferenca)>.001){definirSaldoConta(c,ivNum(c.saldo)-diferenca);p.valor=valor;mudou=true;}
            }
            return mudou;
        }
        function abrirPagamentoCartao(ids,conciliacao=false,escolhaLivre=false){
            const selecionados=[...new Set(ids)].map(id=>dados.despesas.find(x=>x.id===id))
