            sel.innerHTML='<option value="">— Selecione a conta que pagou —</option>'+contas.map(c=>`<option value="${esc(c.nome)}">${tipoConta(c)==='dinheiro'?'💵':'🏦'} ${esc(c.nome)} (${money(c.saldo)})</option>`).join('');
            const sugestao=cartao?.contaPagamento||'';
