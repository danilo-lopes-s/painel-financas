            const valido=ivMovs(inv).filter(x=>x.data&&x.data<=dataAlvo && ['aporte','resgate'].includes(x.tipo));
            const saldo=valido.reduce((s,x)=>s+(x.tipo==='aporte'?1:-1)*ivNum(x.valor)*Math.pow(1+taxa,ivDias(x.data,dataAlvo)/365),0);
            const principal=valido.reduce((s,x)=>s+(x.tipo==='aporte'?1:-1)*ivNum(x.valor),0);
