        function usadoLimiteCartao(c) {return sum(dados.despesas.filter(x=>x.origem==='cartao_'+c.nome&&x.data.slice(0,7)===getGlobalTargetYM()&&pendenteCartao(x)))+reservaFuturaCartao(c);}
