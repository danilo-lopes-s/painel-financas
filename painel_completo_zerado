        // Recorrências independentes dos parcelamentos; registros anteriores são mantidos.
        function recorrenciasDo(tipo, idSerie) {
            return dados[tipo].filter(x => x.recorrenciaId === idSerie).sort((a,b) => (a.numeroRecorrencia||0)-(b.numeroRecorrencia||0));
        }
        function semSufixoRecorrencia(titulo) { return String(titulo||'').replace(/\s*\(\d+\/\d+\)$/,''); }
        function dataOcorrencia(inicio, frequencia, indice) {
            const [ano,mes,dia]=inicio.split('-').map(Number);
            let anoFim=ano,mesFim=mes;
            if(frequencia==='semanal'||frequencia==='quinzenal') {
                const d=new Date(ano,mes-1,dia+(frequencia==='semanal'?7:15)*indice);
                return `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`;
            }
            if(frequencia==='mensal') {mesFim+=indice;anoFim+=Math.floor((mesFim-1)/12);mesFim=(mesFim-1)%12+1;}
            if(frequencia==='anual') anoFim+=indice;
            const diaFim=Math.min(dia,new Date(anoFim,mesFim,0).getDate());
            return `${anoFim}-${String(mesFim).padStart(2,'0')}-${String(diaFim).padStart(2,'0')}`;
        }
        function atualizarCamposRecorrencia(tipo) {
            const prefixo=tipo==='rec'?'rec':'despesa';
            const freq=document.getElementById(prefixo+'Frequencia').value;
            const grupo=document.getElementById(tipo==='rec'?'grupoRecVezes':'grupoDespesaVezes');
            grupo.hidden=(freq==='unica');grupo.style.display=freq==='unica'?'none':'block';
        }
        function quantasRecorrencias(tipo) {
            const prefixo=tipo==='recebimentos'?'rec':'despesa';
            const freq=document.getElementById(prefixo+'Frequencia').value;
            const qtd=freq==='unica'?1:Number(document.getElementById(prefixo+'Vezes').value);
            if(!Number.isInteger(qtd)||qtd<1||qtd>600) {showToast('Informe de 1 a 600 ocorrências.',true);return null;}
            return {freq,qtd};
        }
        function salvarSerie(tipo, anterior, campos, freq, qtd, inicio, tituloBase) {
            const lista=dados[tipo];
            const serieId=anterior?.recorrenciaId || uid('recorrencia');
            const existentes=anterior?.recorrenciaId ? recorrenciasDo(tipo,serieId):anterior?[anterior]:[];
            // Conserva IDs e estados individuais das ocorrências remanescentes.
            const ordenadas=existentes.slice().sort((a,b)=> a.data.localeCompare(b.data));
            const mantidos=new Set();
            for(let i=0;i<qtd;i++) {
                const atual=ordenadas[i];
                const destino=atual||{id:uid(tipo==='despesas'?'desp':'rec')};
                Object.assign(destino,campos,{
                    titulo: qtd>1?`${tituloBase} (${i+1}/${qtd})`:tituloBase,
                    data:dataOcorrencia(inicio,freq,i),
                    recorrenciaId:serieId,numeroRecorrencia:i+1,totalRecorrencias:qtd,
                    frequenciaRecorrencia:freq,inicioRecorrencia:inicio,tituloBaseRecorrencia:tituloBase
                });
                if(tipo==='despesas' && !destino.parcelas) destino.parcelas=1;
                if(!atual) lista.push(destino);
                mantidos.add(destino.id);
            }
            if(ordenadas.length>qtd) {
                // A diminuição solicitada remove exclusivamente as últimas ocorrências desta série.
                dados[tipo]=lista.filter(x=>x.recorrenciaId!==serieId||mantidos.has(x.id));
            }
            return serieId;
        }
        window.alterarEscopoRecorrencia=(tipo)=>{
            const rec=tipo==='recebimentos', p=rec?'rec':'despesa';
            const x=dados[tipo].find(item=>item.id===document.getElementById(rec?'recebimentoIdEdicao':'despesaIdEdicao').value);
            if(!x||!x.recorrenciaId)return;
            const serie=identificarSerie(x,tipo);
            const sozinho=document.getElementById(p+'Escopo').value==='unica';
            const origem=sozinho?x:serie.primeiro;
            document.getElementById(rec?'recTitulo':'despesaTitulo').value=sozinho?x.titulo:(origem.tituloBaseRecorrencia||semSufixoRecorrencia(origem.titulo));
            document.getElementById(rec?'recData':'despesaData').value=sozinho?x.data:(origem.inicioRecorrencia||origem.data);
            document.getElementById(rec?'recValor':'despesaValor').value=origem.valor;
            if(rec){
                document.getElementById('recCat').value=origem.categoriaRecebimento;
                document.getElementById('recConta').value=origem.conta;
                document.getElementById('recContaBox').style.display=origem.categoriaRecebimento==='Pix'?'block':'none';
