                // Antecipacao altera apenas a fatura (mes de vencimento) da parcela.
        // Pagar continua sendo uma acao independente, acionada pelo status Pago.
        function faturasDestinoAntecipacao(x){
            if(!x||(x.origem||'').slice(0,7)!=='cartao_'||(Number(x.parcelas)||1)<=1||
                x.status==='Pago'||x.status==='Cancelado'||x.pagamentoCartao||
                !x.data||x.data.slice(0,7)<=dataLocalPagamento().slice(0,7))return [];
            const ate=dataLocalPagamento().slice(0,7),orig=x.data.slice(0,7);
            const meses=new Set(dados.despesas.filter(d=>d.id!==x.id&&d.origem===x.origem&&d.data)
                .map(d=>d.data.slice(0,7)).filter(m=>m<orig&&m<=ate));
            return [...meses].sort().reverse();
        }
        function botaoAnteciparParcela(x){
            if(!faturasDestinoAntecipacao(x).length)return '';
            return `<button type="button" class="inline-edit-button" title="Antecipar esta parcela para uma fatura existente" aria-label="Antecipar parcela" onclick="event.stopPropagation();${esc(`abrirAntecipacaoParcela(${JSON.stringify(x.id)})`)}">⏩</button> `;
        }
        window.abrirAntecipacaoParcela=id=>{
            const x=dados.despesas.find(d=>d.id===id),meses=faturasDestinoAntecipacao(x);
            if(!x||!meses.length)return showToast('Esta parcela nao possui fatura anterior elegivel para antecipacao.',true);
            document.getElementById('anteciparParcelaId').value=id;
            document.getElementById('anteciparParcelaResumo').textContent=`${x.titulo} · ${money(x.valor)} · fatura original ${formatarData(x.data)}`;
            document.getElementById('anteciparParcelaDestino').innerHTML=meses.map(m=>{
                const [ano,mes]=m.split('-').map(Number);
                const quantidade=dados.despesas.filter(d=>d.origem===x.origem&&d.data?.slice(0,7)===m).length;
                return `<option value="${esc(m)}">${M[mes-1]} ${ano} (${quantidade} lançamento${quantidade===1?'':'s'})</option>`;
            }).join('');
            document.getElementById('anteciparParcelaDestino').value=meses[0];
            openModal('anteciparParcelaModal');
        };
        window.confirmarAntecipacaoParcela=()=>{
            const id=document.getElementById('anteciparParcelaId').value;
            const mes=document.getElementById('anteciparParcelaDestino').value;
            const x=dados.despesas.find(d=>d.id===id);
            if(!x||!faturasDestinoAntecipacao(x).includes(mes))return showToast('Selecione uma fatura existente e valida.',true);
            const c=dados.cartoes.find(c=>c.nome===x.origem.slice(7));
            if(!c)return showToast('O cartao desta parcela nao esta cadastrado.',true);
            const [ano,numeroMes]=mes.split('-').map(Number);
            const dia=Math.min(Number(c.vencimento)||Number(x.data.slice(8,10))||1,new Date(ano,numeroMes,0).getDate());
            const destino=`${mes}-${String(dia).padStart(2,'0')}`;
            const dataOriginal=x.antecipacaoFatura?.dataOriginal||x.data;
            x.antecipacaoFatura={dataOriginal,dataDestino:destino,alteradaEm:dataLocalPagamento()};
            x.data=destino;
            closeModal('anteciparParcelaModal');
            salvarDadosLocal();refresh();showToast('Parcela transferida para a fatura de '+M[numeroMes-1]+'/'+ano+'. Marque Pago quando efetuar o pagamento.');
        };

