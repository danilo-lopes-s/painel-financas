        const invMovNome = x => ({aporte:'Aporte',resgate:'Resgate',compra:'Compra',venda:'Venda',provento:'Provento',rendimento:'Juros / rendimento recebido'})[x]||x;
        function taxaEfetivaInv(i) {
            let base=ivNum(i.taxaBase)/100, taxa=ivNum(i.taxaAnual)/100, pct=ivNum(i.percentualIndexador)/100, spread=ivNum(i.spread)/100;
            if(i.indexador==='CDI') return base*pct+spread;
            if(i.indexador==='IPCA+'||i.indexador==='TR+') return (1+base)*(1+spread)-1;
            if(i.indexador==='Selic') return base+spread;
