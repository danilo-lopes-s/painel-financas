            if(lerSaldo(t.destino)<ivNum(t.valor)-.001)return showToast('Saldo insuficiente no destino para reverter a transferência.',true);
            mudarSaldoTransfer(t.origem,ivNum(t.valor));mudarSaldoTransfer(t.destino,-ivNum(t.valor));
            adicionarRegistroLixeira('transferencias',id,'Transferência: '+(t.nota||formatarData(t.data)),`${money(t.valor)} · ${t.origem} → ${t.destino}. Os saldos foram revertidos; restaurar reaplica o efeito.`,{reaplicarTransferencias:[copiarRegistro(t)]});
            salvarDadosLocal();refresh();showToast('Transferência movida para a lixeira; saldos recalculados.');
        }
