            return `<p style="margin-bottom:9px"><strong>${p.descricao}</strong><br>Este arquivo contém:</p><div style="max-height:290px;overflow:auto">${detalhe}</div><p class="period-note" style="margin:12px 0 0">Além desses registros, serão restaurados os campos adicionais, estados, relacionamentos e ${c.movimentosInvestimento} movimentações internas de investimentos.</p>`;
