            svg+='</svg>';
            return `<div class="ctx-box" style="margin-top:16px"><h3>📈 Evolução do patrimônio investido</h3>${select}<p class="period-note">Série ilustrativa calculada a partir dos aportes e taxas de renda fixa informadas. Na renda variável, aplica-se a cotação manual mais recente às quantidades de cada mês (não são cotações históricas). Clique em um ponto para consultar as operações daquele mês.</p>${svg}</div>`;
        }
