            if(!confirm(msg))return;
            const operacao=uid('pgto');
            for(const x of itens){if(!registrarPagamentoCartao(x,c.nome,data,operacao,jaConsiderado))return showToast('Pagamento interrompido: verifique os registros.',true);}
            for(const nome of new Set(itens.map(x=>x.origem.slice(7)))){
