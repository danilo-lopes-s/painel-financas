        .context-title { font-size: 1.28rem; font-weight: 800; color: #2d3748; margin-top: 5px; display:inline-block; }
        .context-actions { display: flex; gap: 8px; flex-wrap: wrap; align-items:center; }
        
        /* NOVO LOCAL DO SELETOR DE MÊS */
