            salvarDadosLocal();refresh();showToast(jaConsiderado?`${itens.length} pagamento(s) conciliado(s) sem novo debito.`:`${itens.length} pagamento(s) registrado(s); ${money(total)} debitados de ${c.nome}.`);
        };
        function tabelaPagamentosCartaoDaConta(nome){
