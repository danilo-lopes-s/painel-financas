        function gruposParcelas() {
            let grupos=new Map(); dados.despesas.filter(x=>x.parcelas>1).forEach(x=>{let key=x.parcelamentoId||x.origem+'|'+x.titulo.replace(/\s*\(\d+\/\d+\)$/,''); if(!grupos.has(key)) grupos.set(key,[]); grupos.get(key).push(x);}); return grupos;
