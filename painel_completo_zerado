        // === BACKUP JSON VERSIONADO: FIM ===

        function nomeArquivoAtual() {
            let nome = location.pathname.split('/').pop() || '';
            try { nome = decodeURIComponent(nome); } catch (e) {}
            return /^[^\\/:*?"<>|]+\.html?$/i.test(nome) ? nome : 'Painel_Financeiro_V17_Independente.html';
        }

        window.salvarArquivo = async () => {
            dados.timestamp = Date.now();
            const __undoImport = document.getElementById('backupUndoBtn');
            const __undoWasVisible = __undoImport && !__undoImport.hidden;
            if(__undoImport) __undoImport.hidden=true;
            let htmlContent = document.documentElement.outerHTML;
            if(__undoImport) __undoImport.hidden=!__undoWasVisible;
            let safeData = JSON.stringify(dados).replace(/\\/g, '\\\\').replace(/"/g, '\\"').replace(/</g, '\\u003c');
            let regex = /(<script id="dados_injetados">)(.*?)(<\/script>)/is;
            htmlContent = htmlContent.replace(regex, `$1 window.INJETADO = JSON.parse("${safeData}"); $3`);
            const blob = new Blob([`<!DOCTYPE html>\n` + htmlContent], { type: 'text/html;charset=utf-8' });

            try {
                if (window.showSaveFilePicker) {
                    const fileHandle = await window.showSaveFilePicker({ suggestedName: nomeArquivoAtual(), types: [{ description: 'Arquivo HTML', accept: {'text/html': ['.html']} }] });
                    const writable = await fileHandle.createWritable(); await writable.write(blob); await writable.close();
                    limparIndicadorAlteracao(); salvarDadosLocal(true); showToast('✅ Arquivo salvo/sobrescrito!');
                } else throw new Error("Fallback");
            } catch (err) {
                if(err.name !== 'AbortError') { const a = document.createElement('a'); a.href = URL.createObjectURL(blob); a.download = nomeArquivoAtual(); document.body.appendChild(a); a.click(); document.body.removeChild(a); limparIndicadorAlteracao(); showToast('✅ Download gerado!'); }
            }
        };

        const esc = v => String(v ?? '').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
        const chamada = (view,id) => esc(`selecionarVisao(${JSON.stringify(view)},${JSON.stringify(id)})`);
        function graficoBarras(titulo, valores, acao=null, opts=null) {
