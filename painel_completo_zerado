        const tipoConta=c=>{const t=String(c?.tipo||'').toLowerCase();return t.includes('dinheiro')||t.includes('fisic')?'dinheiro':t.includes('poup')?'poupança':t.includes('invest')?'investimento':t.includes('previd')?'previdência':'corrente';};
