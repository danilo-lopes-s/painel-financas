            let diffDias = Math.floor((new Date(dataBaseIso + 'T00:00:00') - new Date(today() + 'T00:00:00')) / 86400000);
            if(diffDias < 0) return { classe: 's-vencido', texto: 'Atrasado' };
            if(diffDias === 0) return { classe: 's-hoje', texto: 'É Hoje' };
            if(diffDias <= 5) return { classe: 's-breve', texto: `Em ${diffDias} d` };
            return { classe: 's-futuro', texto: 'Futuro' };
        }
        function statusInfo(tipo, x) {
            let status = x.status || (tipo==='recebimentos'?'Recebido':tipo==='planejamentos'?'Planejado':'Pendente');
            if(status==='Cancelado') return {classe:'s-cancelado',texto:'Cancelado'};
            if(status==='Pago' || status==='Recebido' || status==='Confirmado') return {classe:'s-pago', texto:status};
            let info=getStatusData(x.data,false);
            return {classe:info.classe,texto:tipo==='planejamentos'?status:info.texto};
        }
        function statusControle(tipo, x) {
