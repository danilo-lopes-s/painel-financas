        function abrirTransferencia(id=null) {
            garantirModulos();const t=id?dados.transferencias.find(x=>x.id===id):null;
            document.getElementById('trModalTitle').textContent=t?'✏️ Editar transferência':'🔄 Nova transferência';document.getElementById('trId').value=t?.id||'';
            const opts=contasTransferencia().map(c=>`<option value="${esc(c.chave)}">${esc(c.nome)} (${money(c.saldo)})</option>`).join('');
            document.getElementById('trOrigem').innerHTML=opts;document.getElementById('trDestino').innerHTML=opts;
            document.getElementById('trOrigem').value=t?.origem||contasTransferencia()[0]?.chave;
            document.getElementById('trDestino').value=t?.destino||contasTransferencia()[1]?.chave||'fisico';
