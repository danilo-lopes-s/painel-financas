        .period-note { color:var(--muted); font-size:.8rem; margin-bottom:12px; }
        body.dark { --bg:#141b2a; --surface:#202a3b; --text-main:#edf2f7; --line:#3b4960; --muted:#b7c3d4; }
        body.dark .ctx-box,body.dark .ctx-kpi,body.dark .donut-hole,body.dark .cal-day,body.dark .modal-content,body.dark .evolution-panel,body.dark .segmented button { background:var(--surface); color:var(--text-main); }
