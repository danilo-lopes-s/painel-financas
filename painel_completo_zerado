                    <div class="card nav-card" draggable="false" data-view="contas" onclick="selecionarVisao('contas')"><div class="card-icon">🏦</div><div class="card-title">Contas</div><div class="card-value" id="totalContas">0</div><span class="nav-arrow">☰</span></div>
