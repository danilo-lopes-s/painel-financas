        // === FIM PAGAMENTOS REAIS DE CARTAO ===

        // === BACKUP JSON VERSIONADO: INICIO ===
        // Este contrato guarda os dados e seus relacionamentos, não a aparência da interface.
        const BACKUP_FORMATO = 'PainelFinanceiro';
        const BACKUP_VERSAO_ESTRUTURA = 1;
        const BACKUP_LISTAS = ['contas','cartoes','despesas','recebimentos','planejamentos','categorias',
                              'investimentos','transferencias','movContas','tiposInvestimento','lixeira','navOrder'];
        const BACKUP_LISTAS_REGISTROS = BACKUP_LISTAS.filter(x=>x!=='navOrder');
        let backupPendente = null;
        let backupAntesDaImportacao = null;

        const copiaBackup = valor => JSON.parse(JSON.stringify(valor));

        function contagensBackup(d) {
            const r = {};
            BACKUP_LISTAS.forEach(k => { r[k] = Array.isArray(d[k]) ? d[k].length : 0; });
            r.movimentosInvestimento = (d.investimentos||[]).reduce((n,i)=>n+(Array.isArray(i.movimentos)?i.movimentos.length:0),0);
            return r;
        }

        function criarConteudoBackup(d = dados) {
            return {
                formato: BACKUP_FORMATO,
                versaoEstrutura: BACKUP_VERSAO_ESTRUTURA,
                versaoPainel: 'Painel HTML independente (backup v1)',
                exportadoEm: new Date().toISOString(),
                dados: copiaBackup(d)
            };
        }

        window.exportarDadosJSON = () => {
            try {
                const conteudo = JSON.stringify(criarConteudoBackup(), null, 2);
                const blob = new Blob([conteudo+'\n'],{type:'application/json;charset=utf-8'});
                const url = URL.createObjectURL(blob), a=document.createElement('a');
                const stamp=new Date().toISOString().slice(0,19).replace(/[:T]/g,'-');
                a.href=url;
                a.download=`Backup_Painel_Financeiro_${stamp}.json`;
                document.body.appendChild(a);a.click();a.remove();
                setTimeout(()=>URL.revokeObjectURL(url),60000);
                showToast('Backup JSON gerado. Guarde o arquivo em local seguro.');
            } catch(e) { console.error('Erro ao exportar backup:',e);showToast('Não foi possível exportar o backup.',true); }
        };

        function conferirSegurancaBackup(obj,prof=0) {
            if(prof>45)throw Error('Backup com profundidade de dados excessiva.');
            if(!obj||typeof obj!=='object')return;
            for(const k of Object.keys(obj)){
                if(k==='__proto__'||k==='constructor'||k==='prototype')throw Error('Backup possui uma chave não permitida.');
                const v=obj[k];
                if(typeof v==='number'&&!Number.isFinite(v))throw Error('Backup possui número inválido.');
                if(v&&typeof v==='object')conferirSegurancaBackup(v,prof+1);
            }
        }

        function prepararImportacaoJSON(obj) {
            if(!obj||typeof obj!=='object'||Array.isArray(obj))throw Error('O conteúdo JSON precisa ser um objeto válido.');
            let raw,versao,descricao;
            if(obj.formato===BACKUP_FORMATO){
                versao=Number(obj.versaoEstrutura);
                if(!Number.isInteger(versao)||versao<1||versao>BACKUP_VERSAO_ESTRUTURA)
                    throw Error('Versão da estrutura incompatível. É necessário um conversor de dados para este backup.');
                raw=obj.dados;
                descricao=`Formato oficial v${versao}`;
            }else if(['contas','cartoes','despesas','recebimentos','planejamentos','investimentos','transferencias'].some(k=>Array.isArray(obj[k]))){
                raw=obj;
                versao=0;
                descricao='Estrutura antiga de dados reconhecida';
            }else throw Error('Formato de arquivo não reconhecido como backup deste painel.');
            if(!raw||typeof raw!=='object'||Array.isArray(raw))throw Error('O arquivo não contém dados financeiros válidos.');
            conferirSegurancaBackup(raw);
            const recebido=copiaBackup(raw);
            BACKUP_LISTAS.forEach(k=>{
                if(recebido[k]===undefined)recebido[k]=[];
                if(!Array.isArray(recebido[k]))throw Error(`Campo "${k}" não é uma lista válida.`);
            });
            BACKUP_LISTAS_REGISTROS.forEach(k=>{
                if(recebido[k].some(x=>!x||typeof x!=='object'||Array.isArray(x)))
                    throw Error(`O campo "${k}" contém um registro inválido.`);
            });
            if(recebido.dinheiroFisico===undefined)recebido.dinheiroFisico=0;
            if(!Number.isFinite(Number(recebido.dinheiroFisico)))throw Error('Saldo de dinheiro físico inválido.');
            if(recebido.timestamp===undefined)recebido.timestamp=0;
            // Evita a criação automática de registros demonstrativos ao reabrir o HTML.
            recebido.exemplosV13=true;
            recebido.exemplosInvestV17=true;
            recebido.demoContasV18=true;
            // Backups legados são mantidos sem reaplicar saldos de recebimentos históricos.
            if(recebido.migracaoRecebV1===undefined)recebido.migracaoRecebV1=true;
            if(recebido.zerado===undefined)recebido.zerado=true;
            return {dados:recebido,descricao,versao};
        }

        function resumoImportacaoHTML(p) {
            const c=contagensBackup(p.dados),titulos={contas:'Contas',cartoes:'Cartões',despesas:'Despesas',
                recebimentos:'Recebimentos',planejamentos:'Metas a receber',categorias:'Categorias',
