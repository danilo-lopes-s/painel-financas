                    <div class="card nav-card" draggable="false" data-view="recebimentos" onclick="selecionarVisao('recebimentos')"><div class="card-icon">💰</div><div class="card-title">Recebimentos</div><div class="card-value" id="totalRecebimentos">R$&nbsp;0,00</div><span class="nav-arrow">☰</span></div>
