            document.getElementById('pagtoCartaoItens').innerHTML=selecionados.sort((a,b)=>a.data.localeCompare(b.data)).map(x=>
                `<label class="pgto-linha"><input type="checkbox" class="pgto-check" value="${esc(x.id)}" ${conciliacao||escolhaLivre?'':'checked'} onchange="atualizarTotalPagamentoCartao()"><span><strong>${esc(x.titulo)}</strong><small class="subtle-line">Fatura: ${formatarData(x.data)} · ${esc(x.origem.slice(7))}</small></span><b>${money(x.valor)}</b></label>`).join('');
