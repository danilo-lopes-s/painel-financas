        function salvarTransferencia() {
            const id=document.getElementById('trId').value,origem=document.getElementById('trOrigem').value,destino=document.getElementById('trDestino').value;
            const valor=Math.round(ivNum(document.getElementById('trValor').value)*100)/100,data=document.getElementById('trData').value;
            if(!data||!origem||!destino||origem===destino||valor<=0)return showToast('Preencha valor, data e contas distintas.',true);
            const antiga=dados.transferencias.find(x=>x.id===id);
            if(lerSaldo(origem)===null||lerSaldo(destino)===null)return showToast('Conta selecionada não existe.',true);
            // Reversão virtual: origem anterior recupera crédito; destino anterior perde o crédito recebido.
            const saldoDisponivel=lerSaldo(origem)+(antiga&&antiga.origem===origem?ivNum(antiga.valor):0)-(antiga&&antiga.destino===origem?ivNum(antiga.valor):0);
            const destinoAposReversao=lerSaldo(destino)+(antiga&&antiga.origem===destino?ivNum(antiga.valor):0)-(antiga&&antiga.destino===destino?ivNum(antiga.valor):0);
            if(saldoDisponivel+1e-8<valor)return showToast('Saldo insuficiente na origem.',true);
            if(antiga&&lerSaldo(antiga.destino)<ivNum(antiga.valor)-.001)return showToast('Saldo insuficiente no destino original para desfazer a transferência anterior.',true);
            if(destinoAposReversao<-.001)return showToast('Não é possível editar: o destino não tem saldo para reverter.',true);
            if(antiga){mudarSaldoTransfer(antiga.origem,ivNum(antiga.valor));mudarSaldoTransfer(antiga.destino,-ivNum(antiga.valor));}
            mudarSaldoTransfer(origem,-valor);mudarSaldoTransfer(destino,valor);
            const obj={id:id||uid('tr'),data,origem,destino,valor,nota:document.getElementById('trNota').value.trim()};
            if(antiga)Object.assign(antiga,obj);else dados.transferencias.push(obj);
            closeModal('transferenciaModal');salvarDadosLocal();refresh();selecionarVisao('transferencias');showToast('Transferência registrada; saldos atualizados.');
        }
        function excluirTransferencia(id) {
            const t=dados.transferencias.find(x=>x.id===id);if(!t||!confirm('Excluir esta transferência e desfazer seus efeitos nos saldos atuais?'))return;
            if(lerSaldo(t.origem)===null||lerSaldo(t.destino)===null)return showToast('Não foi possível localizar uma das contas.',true);
            if(lerSaldo(t.destino)<ivNum(t.valor)-.001)return showToast('Saldo insuficiente no destino para reverter a transferência.',true);
            mudarSaldoTransfer(t.origem,ivNum(t.valor));mudarSaldoTransfer(t.destino,-ivNum(t.valor));
            dados.transferencias=dados.transferencias.filter(x=>x.id!==id);salvarDadosLocal();refresh();showToast('Transferência revertida.');
        }
