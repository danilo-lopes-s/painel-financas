</div>
    <div id="planModal" class="modal" onclick="if(event.target===this) closeModal('planModal')"><div class="modal-content"><div class="modal-header"><h2 id="tituloModalPlan">🎯 Planejar Meta</h2><button class="modal-close" onclick="closeModal('planModal')">✕</button></div><input type="hidden" id="planIdEdicao"><div class="form-group"><label>Descrição da Meta</label><input type="text" id="planDesc"></div><div class="form-row"><div class="form-group"><label>Valor Esperado</label><input type="number" id="planValor" step="0.01"></div><div class="form-group"><label>Data Prevista</label><input type="date" id="planData"></div></div><div class="form-row" id="planFrequenciaBox" style="background:#f7fafc;padding:10px;border-radius:8px;margin-bottom:15px;"><div class="form-group" style="margin-bottom:0;"><label>Frequência (Gerar lotes)</label><select id="planFrequencia" onchange="document.getElementById('grupoPlanVezes').style.display=this.value==='unica'?'none':'block'"><option value="unica">Apenas esta</option><option value="semanal">Semanal</option><option value="quinzenal">Quinzenal</option><option value="mensal">Mensal</option></select></div><div class="form-group" id="grupoPlanVezes" style="display:none;margin-bottom:0;"><label>Qtd Meses/Semanas</label><input type="number" id="planVezes" min="2" value="2"></div></div><button class="btn btn-primary" id="btnSalvarPlan" onclick="salvarPlanejamento()">Salvar Planejamento</button></div></div>
    <div id="categoriaModal" class="modal" onclick="if(event.target===this) closeModal('categoriaModal')"><div class="modal-content"><div class="modal-header"><h2 id="tituloModalCategoria">🏷️ Categoria</h2><button class="modal-close" onclick="closeModal('categoriaModal')">✕</button></div><input type="hidden" id="categoriaIdEdicao"><div class="form-row"><div class="form-group"><label>Nome</label><input type="text" id="catNome"></div><div class="form-group"><label>Cor</label><input type="color" id="catCor" value="#667eea" style="height:42px;padding:5px;"></div></div><div class="form-group"><label>Ícone (Selecione)</label><input type="text" id="catIcone" readonly="" style="background:#f8fafc;font-size:1.5em;text-align:center;"><div class="icon-grid" id="iconeBiblioteca"></div></div><button class="btn btn-primary" onclick="salvarCategoria()">Salvar Categoria</button></div></div>


    <!-- Cadastro de ativos (dados independentes de saldos e transações de contas) -->
    <div id="investimentoModal" class="modal" onclick="if(event.target===this)closeModal('investimentoModal')"><div class="modal-content" style="max-width:790px"><div class="modal-header"><h2 id="invFormTitle">Novo investimento</h2><button class="modal-close" onclick="closeModal('investimentoModal')">✕</button></div>
        <input type="hidden" id="invId"><div class="form-row"><div class="form-group"><label>Classe</label><select id="invClasse" onchange="popularTiposInv()"><option value="fixa">Renda Fixa</option><option value="variavel">Renda Variável</option></select></div><div class="form-group"><label>Tipo de investimento</label><select id="invTipo" onchange="renderInvExtras()"></select></div></div>
