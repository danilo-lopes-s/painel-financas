    <script>
        // ==========================================
        // 1. ESTADOS GLOBAIS E INICIALIZAÇÃO
        // ==========================================
        let dados = { contas: [], cartoes: [], despesas: [], recebimentos: [], planejamentos: [], categorias: [], investimentos: [], transferencias: [], tiposInvestimento: [], dinheiroFisico: 0, navOrder: [], timestamp: 0 };
        let visao = 'principal', visaoAnterior = 'principal', itemAtual = null, hasUnsavedChanges = false, metric = 'saldo';
        
        let globalAno = new Date().getFullYear();
        let globalMes = new Date().getMonth();
        let modoPeriodo = 'mes', globalDia = new Date().getDate(), historicoVisoes = [], calendarioExibicao = 'valor'; 
        let filters = { despesas: { text: '', cat: '', sort: 'date_desc' }, recebimentos: { text: '', cat: '', sort: 'date_desc' } };

        const M = ['Janeiro','Fevereiro','Março','Abril','Maio','Junho','Julho','Agosto','Setembro','Outubro','Novembro','Dezembro'];
        const M_SHORT = ['Jan','Fev','Mar','Abr','Mai','Jun','Jul','Ago','Set','Out','Nov','Dez'];
        const money = v => new Intl.NumberFormat('pt-BR', {style: 'currency', currency: 'BRL'}).format(Number(v) || 0);
        const uid = p => p + '_' + Date.now().toString(36) + Math.random().toString(36).slice(2,6);
        const today = () => new Date().toISOString().slice(0,10);
        const getGlobalTargetYM = () => `${globalAno}-${String(globalMes+1).padStart(2,'0')}`;
        const formatarData = v => { if(!v) return ''; let p = v.split('-'); return `${p[2]}/${p[1]}/${p[0]}`; };
        const sum = (a, k='valor') => a.reduce((t, x) => t + (Number(x[k]) || 0), 0);

        const bibliotecaIcones = ['🍔','🏠','🚗','🚌','✈️','🏥','💊','🎮','⚽','👕','🛍️','📚','💻','📱','👦','🧒','🧘','💆','🛒','🛠️','✂️','⚡','💧','🔥','🧾','💰','💎'];

        function boot() {
            // Forcei v9 para popular dados corretamente a pedido do usuário
            let localData = null; try { localData = JSON.parse(localStorage.getItem('painelFinanceiro_v9')); } catch(e) {}
            let fileData = window.INJETADO; 

            if (fileData) { dados = fileData; } else if (localData) { dados = localData; } else { gerarDadosDeExemplo(); }
            
            garantirModulos();
            adicionarDemonstracaoInvestV17();
            // Garantir Categorias pedidas (se vier vazio ou v9 limpar)
            if(!dados.zerado && (!dados.categorias || dados.categorias.length === 0)) {
                dados.categorias = [
                    { id: uid('cat'), nome: 'Alimentação', icon: '🍔', cor: '#f56565' },
                    { id: uid('cat'), nome: 'Moradia', icon: '🏠', cor: '#4299e1' },
                    { id: uid('cat'), nome: 'Transporte', icon: '🚗', cor: '#ed8936' },
                    { id: uid('cat'), nome: 'Lazer', icon: '🎮', cor: '#9f7aea' },
                    { id: uid('cat'), nome: 'Médicos e Farmácia', icon: '🏥', cor: '#48bb78' },
                    { id: uid('cat'), nome: 'Pensão e extras - Felipe', icon: '👦', cor: '#38b2ac' },
                    { id: uid('cat'), nome: 'Saúde e Bem Estar', icon: '🧘', cor: '#4fd1c5' },
                    { id: uid('cat'), nome: 'Compras para Casa', icon: '🛒', cor: '#ecc94b' },
                    { id: uid('cat'), nome: 'Outros', icon: '📦', cor: '#a0aec0' }
                ];
            }
            dados.despesas.forEach(d => { if(!d.id) d.id = uid('desp'); });
            dados.recebimentos.forEach(r => { if(!r.id) r.id = uid('rec'); });
            dados.planejamentos.forEach(p => { if(!p.id) p.id = uid('plan'); });

             if(!dados.zerado) adicionarExemplosV13();
            restaurarOrdemCards();
            salvarDadosLocal(true); atualizarLabelMes(); setTimeout(refresh, 0);
            initDragAndDrop();
        }

        // DADOS FICTÍCIOS DE EXEMPLO (3 MESES DE HISTÓRICO)
        function gerarDadosDeExemplo() {
            dados = { contas: [], cartoes: [], despesas: [], recebimentos: [], planejamentos: [], categorias: [], dinheiroFisico: 0, navOrder: [], timestamp: Date.now() };
            dados.categorias = [
                { id: uid('cat'), nome: 'Alimentação', icon: '🍔', cor: '#f56565' }, { id: uid('cat'), nome: 'Moradia', icon: '🏠', cor: '#4299e1' },
                { id: uid('cat'), nome: 'Transporte', icon: '🚗', cor: '#ed8936' }, { id: uid('cat'), nome: 'Lazer', icon: '🎮', cor: '#9f7aea' },
                { id: uid('cat'), nome: 'Médicos e Farmácia', icon: '🏥', cor: '#48bb78' }, { id: uid('cat'), nome: 'Pensão e extras - Felipe', icon: '👦', cor: '#38b2ac' },
                { id: uid('cat'), nome: 'Saúde e Bem Estar', icon: '🧘', cor: '#4fd1c5' }, { id: uid('cat'), nome: 'Compras para Casa', icon: '🛒', cor: '#ecc94b' },
                { id: uid('cat'), nome: 'Outros', icon: '📦', cor: '#a0aec0' }
            ];
            dados.contas.push({ nome: "Nubank", tipo: "corrente", saldo: 8500.00 }, { nome: "Itaú", tipo: "corrente", saldo: 4200.00 });
            let cItau = { nome: "Itaú Black", bandeira: "visa", limite: 15000, vencimento: 15, faturaAtual: 0 };
            dados.cartoes.push(cItau);

            let dt = new Date();
            for(let mOffset = 0; mOffset <= 2; mOffset++) { // Histórico de 3 meses para trás
                let d = new Date(dt.getFullYear(), dt.getMonth() - mOffset, 1);
                let y = d.getFullYear(), m = String(d.getMonth() + 1).padStart(2, '0');
                
                // Despesas do mês
                dados.despesas.push({ id: uid('desp'), titulo: "Supermercado", categoria: "Compras para Casa", valor: 850, data: `${y}-${m}-05`, origem: "cartao_Itaú Black", parcelas: 1 });
                dados.despesas.push({ id: uid('desp'), titulo: "Pensão Felipe", categoria: "Pensão e extras - Felipe", valor: 1200, data: `${y}-${m}-10`, origem: "conta_Itaú", parcelas: 1 });
                dados.despesas.push({ id: uid('desp'), titulo: "Combustível", categoria: "Transporte", valor: 250, data: `${y}-${m}-12`, origem: "conta_Nubank", parcelas: 1 });
                dados.despesas.push({ id: uid('desp'), titulo: "Consulta Médica", categoria: "Médicos e Farmácia", valor: 300, data: `${y}-${m}-20`, origem: "cartao_Itaú Black", parcelas: 1 });
                
                // Parcela espalhada
                if (mOffset === 2) {
                    dados.despesas.push({ id: uid('desp'), titulo: "TV Nova (1/3)", categoria: "Moradia", valor: 1500, data: `${y}-${m}-15`, origem: "cartao_Itaú Black", parcelas: 3 });
                } else if (mOffset === 1) {
                    dados.despesas.push({ id: uid('desp'), titulo: "TV Nova (2/3)", categoria: "Moradia", valor: 1500, data: `${y}-${m}-15`, origem: "cartao_Itaú Black", parcelas: 3 });
                } else {
                    dados.despesas.push({ id: uid('desp'), titulo: "TV Nova (3/3)", categoria: "Moradia", valor: 1500, data: `${y}-${m}-15`, origem: "cartao_Itaú Black", parcelas: 3 });
                }

                // Receitas
                dados.recebimentos.push({ id: uid('rec'), titulo: "Salário", valor: 6500, data: `${y}-${m}-05`, categoriaRecebimento: "Pix", conta: "Itaú" });
                dados.planejamentos.push({ id: uid('plan'), descricao: "Venda Freela", valor: 1500, data: `${y}-${m}-25`, status: mOffset>0?'Confirmado':'Planejado' });
            }
            dados.dinheiroFisico = 450;
        }

        window.addEventListener('beforeunload', (e) => { if(hasUnsavedChanges) { e.preventDefault(); e.returnValue = 'Alterações não salvas!'; } });
        function marcarAlteracao() { hasUnsavedChanges = true; document.getElementById('unsavedIndicator').hidden=false; }
        function limparIndicadorAlteracao() { hasUnsavedChanges=false; document.getElementById('unsavedIndicator').hidden=true; }
        function salvarDadosLocal(isBoot = false) { localStorage.setItem('painelFinanceiro_v9', JSON.stringify(dados)); if(!isBoot) marcarAlteracao(); }

        function mudarMes(delta) { let d = new Date(globalAno, globalMes + delta, 1); globalAno=d.getFullYear(); globalMes=d.getMonth(); globalDia=Math.min(globalDia,new Date(globalAno,globalMes+1,0).getDate()); atualizarLabelMes(); refresh(); }
        function emPeriodo(x) { return x.data && (modoPeriodo==='dia' ? x.data === `${getGlobalTargetYM()}-${String(globalDia).padStart(2,'0')}` : x.data.slice(0,7)===getGlobalTargetYM()); }
        function alterarModo(modo) { modoPeriodo=modo; atualizarLabelMes(); refresh(); }
        function selecionarPeriodo(value) { if(!/^\d{4}-\d{2}(-\d{2})?$/.test(value)) return; let [y,m,d]=value.split('-').map(Number); globalAno=y; globalMes=m-1; globalDia=d||Math.min(globalDia,new Date(y,m,0).getDate()); atualizarLabelMes(); refresh(); }
        function moverPeriodo(delta) { if(modoPeriodo==='mes') return mudarMes(delta); let d=new Date(globalAno,globalMes,globalDia+delta); globalAno=d.getFullYear(); globalMes=d.getMonth(); globalDia=d.getDate(); atualizarLabelMes(); refresh(); }
        function atualizarLabelMes() { document.getElementById('globalMonthLabel').textContent = modoPeriodo==='dia' ? formatarData(`${getGlobalTargetYM()}-${String(globalDia).padStart(2,'0')}`) : `${M[globalMes]} ${globalAno}`; document.getElementById('monthInput').value=getGlobalTargetYM(); document.getElementById('dayInput').value=`${getGlobalTargetYM()}-${String(globalDia).padStart(2,'0')}`; document.getElementById('periodMode').value=modoPeriodo; document.getElementById('dayField').hidden=modoPeriodo!=='dia'; document.getElementById('monthField').hidden=modoPeriodo!=='mes'; }

        function getStatusData(dataBaseIso, isPago) {
            if(isPago) return { classe: 's-pago', texto: 'Concluído' };
            let diffDias = Math.floor((new Date(dataBaseIso + 'T00:00:00') - new Date(today() + 'T00:00:00')) / 86400000);
            if(diffDias < 0) return { classe: 's-vencido', texto: 'Atrasado' };
            if(diffDias === 0) return { classe: 's-hoje', texto: 'É Hoje' };
            if(diffDias <= 5) return { classe: 's-breve', texto: `Em ${diffDias} d` };
            return { classe: 's-futuro', texto: 'Futuro' };
        }
        function statusInfo(tipo, x) {
            let status = x.status || (tipo==='recebimentos'?'Recebido':tipo==='planejamentos'?'Planejado':'Pendente');
            if(status==='Cancelado') return {classe:'s-cancelado',texto:'Cancelado'};
            if(status==='Pago' || status==='Recebido' || status==='Confirmado') return {classe:'s-pago', texto:status};
            let info=getStatusData(x.data,false);
            return {classe:info.classe,texto:tipo==='planejamentos'?status:info.texto};
        }
        function statusControle(tipo, x) {
            let status = x.status || (tipo==='recebimentos'?'Recebido':tipo==='planejamentos'?'Planejado':'Pendente');
            let opcoes = tipo==='recebimentos' ? ['Pendente','Recebido','Cancelado'] : tipo==='planejamentos' ? ['Planejado','Confirmado','Cancelado'] : ['Pendente','Pago','Cancelado'];
            let info = statusInfo(tipo,x);
            return `<select class="status-select ${info.classe}" aria-label="Alterar status de ${esc(x.titulo||x.descricao||'lançamento')}" title="Clique para alterar o status" onclick="event.stopPropagation()" onmousedown="event.stopPropagation()" onchange="event.stopPropagation();${esc(`atualizarStatus(${JSON.stringify(tipo)},${JSON.stringify(x.id)},this.value)`)}">${opcoes.map(v=>`<option value="${v}" ${v===status?'selected':''}>${v===status?info.texto:v}</option>`).join('')}</select>`;
        }
        window.atualizarStatus = (tipo,id,novo) => {
            let opcoes = tipo==='recebimentos' ? ['Pendente','Recebido','Cancelado'] : tipo==='planejamentos' ? ['Planejado','Confirmado','Cancelado'] : ['Pendente','Pago','Cancelado'];
            if(!opcoes.includes(novo) || !['despesas','recebimentos','planejamentos'].includes(tipo)) return;
            let x=dados[tipo].find(i=>i.id===id); if(!x) return;
            x.status=novo; salvarDadosLocal(); refresh(); showToast('Status atualizado.');
        };
        function statusControleGrupo(id,itens) {
            let presentes = itens.filter(emPeriodo);
            let valores=[...new Set(presentes.map(x=>x.status||'Pendente'))];
            let valor=valores.length===1?valores[0]:'Misto';
            let exemplo={...(presentes[0]||itens[0]),status:valor==='Misto'?'Pendente':valor};
            let info=valor==='Misto'?{classe:'s-breve',texto:'Misto'}:statusInfo('despesas',exemplo);
            return `<select class="status-select ${info.classe}" aria-label="Status das parcelas no período" onclick="event.stopPropagation()" onchange="event.stopPropagation();${esc(`atualizarStatusGrupo(${JSON.stringify(id)},this.value)`)}">${valor==='Misto'?'<option value="Misto" selected disabled>Misto</option>':''}${['Pendente','Pago','Cancelado'].map(v=>`<option value="${v}" ${v===valor?'selected':''}>${v===valor?info.texto:v}</option>`).join('')}</select>`;
        }
        window.atualizarStatusGrupo = (id,novo) => {
            if(!['Pendente','Pago','Cancelado'].includes(novo)) return;
            let grupo=gruposParcelas().get(id); if(!grupo) return;
            grupo.filter(emPeriodo).forEach(x=>x.status=novo);
            salvarDadosLocal(); refresh(); showToast('Status das parcelas do período atualizado.');
        };

        // Recorrências independentes dos parcelamentos; registros anteriores são mantidos.
        function recorrenciasDo(tipo, idSerie) {
            return dados[tipo].filter(x => x.recorrenciaId === idSerie).sort((a,b) => (a.numeroRecorrencia||0)-(b.numeroRecorrencia||0));
        }
        function semSufixoRecorrencia(titulo) { return String(titulo||'').replace(/\s*\(\d+\/\d+\)$/,''); }
        function dataOcorrencia(inicio, frequencia, indice) {
            const [ano,mes,dia]=inicio.split('-').map(Number);
            let anoFim=ano,mesFim=mes;
            if(frequencia==='semanal'||frequencia==='quinzenal') {
                const d=new Date(ano,mes-1,dia+(frequencia==='semanal'?7:15)*indice);
                return `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`;
            }
            if(frequencia==='mensal') {mesFim+=indice;anoFim+=Math.floor((mesFim-1)/12);mesFim=(mesFim-1)%12+1;}
            if(frequencia==='anual') anoFim+=indice;
            const diaFim=Math.min(dia,new Date(anoFim,mesFim,0).getDate());
            return `${anoFim}-${String(mesFim).padStart(2,'0')}-${String(diaFim).padStart(2,'0')}`;
        }
        function atualizarCamposRecorrencia(tipo) {
            const prefixo=tipo==='rec'?'rec':'despesa';
            const freq=document.getElementById(prefixo+'Frequencia').value;
            const grupo=document.getElementById(tipo==='rec'?'grupoRecVezes':'grupoDespesaVezes');
            grupo.hidden=(freq==='unica');grupo.style.display=freq==='unica'?'none':'block';
        }
        function quantasRecorrencias(tipo) {
            const prefixo=tipo==='recebimentos'?'rec':'despesa';
            const freq=document.getElementById(prefixo+'Frequencia').value;
            const qtd=freq==='unica'?1:Number(document.getElementById(prefixo+'Vezes').value);
            if(!Number.isInteger(qtd)||qtd<1||qtd>600) {showToast('Informe de 1 a 600 ocorrências.',true);return null;}
            return {freq,qtd};
        }
        function salvarSerie(tipo, anterior, campos, freq, qtd, inicio, tituloBase) {
            const lista=dados[tipo];
            const serieId=anterior?.recorrenciaId || uid('recorrencia');
            const existentes=anterior?.recorrenciaId ? recorrenciasDo(tipo,serieId):anterior?[anterior]:[];
            // Conserva IDs e estados individuais das ocorrências remanescentes.
            const ordenadas=existentes.slice().sort((a,b)=> a.data.localeCompare(b.data));
            const mantidos=new Set();
            for(let i=0;i<qtd;i++) {
                const atual=ordenadas[i];
                const destino=atual||{id:uid(tipo==='despesas'?'desp':'rec')};
                Object.assign(destino,campos,{
                    titulo: qtd>1?`${tituloBase} (${i+1}/${qtd})`:tituloBase,
                    data:dataOcorrencia(inicio,freq,i),
                    recorrenciaId:serieId,numeroRecorrencia:i+1,totalRecorrencias:qtd,
                    frequenciaRecorrencia:freq,inicioRecorrencia:inicio,tituloBaseRecorrencia:tituloBase
                });
                if(tipo==='despesas' && !destino.parcelas) destino.parcelas=1;
                if(!atual) lista.push(destino);
                mantidos.add(destino.id);
            }
            if(ordenadas.length>qtd) {
                // A diminuição solicitada remove exclusivamente as últimas ocorrências desta série.
                dados[tipo]=lista.filter(x=>x.recorrenciaId!==serieId||mantidos.has(x.id));
            }
        }
        window.alterarEscopoRecorrencia=(tipo)=>{
            const rec=tipo==='recebimentos', p=rec?'rec':'despesa';
