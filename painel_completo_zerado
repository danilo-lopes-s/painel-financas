        .progress-bar span { display: block; height: 100%; transition: width 0.5s; }

        .donut-chart { width: 160px; height: 160px; border-radius: 50%; display: flex; justify-content: center; align-items: center; margin: 0 auto 15px; position: relative; }
        .donut-hole { width: 100px; height: 100px; background: #fff; border-radius: 50%; position: absolute; z-index: 10; display:flex; justify-content:center; align-items:center; flex-direction:column; }
        .donut-hole span { font-size: 0.7em; color: var(--muted); font-weight:bold; }
        .donut-hole strong { font-size: 1.1em; color: var(--text-main); }

        .calendar-wrapper { border: 1px solid var(--line); border-radius: 12px; overflow: hidden; }
