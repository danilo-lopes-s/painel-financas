        function graficoLinhas(id,opts){
            const {labels,series,detalhe,titulo='',nota='',altura=250,selecionavel=false}=opts;
            registroGraficos[id]={labels,series,detalhe,opts};
            const ocultas=seriesOcultas[id]||new Set(), visiveis=series.map((s,si)=>({s,si})).filter(o=>!selecionavel||!ocultas.has(o.s.nome));
            const W=900,H=altura,L=86,R=20,T=16,B=36, vals=visiveis.flatMap(o=>o.s.valores);
            let max=Math.max(0,...vals), min=Math.min(0,...vals); if(max===min) max=min+1;
            const amp=max-min, x=i=>labels.length===1?(L+W-R)/2:L+i*(W-L-R)/(labels.length-1), y=v=>T+(max-v)/amp*(H-T-B);
            let grid='';for(let i=0;i<=4;i++){const v=max-i*amp/4,yy=T+i*(H-T-B)/4;grid+=`<line x1="${L}" y1="${yy}" x2="${W-R}" y2="${yy}" stroke="var(--line)"/><text x="${L-6}" y="${yy+4}" text-anchor="end" font-size="11" fill="var(--muted)">${esc(abrevMoney(v))}</text>`;}
            const step=Math.max(1,Math.ceil(labels.length/12));
