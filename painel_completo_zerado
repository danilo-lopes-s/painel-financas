                const atual=aplicarFluxosFixos(inv,today());
                const valor=(inv.saldoAtual!==''&&inv.saldoAtual!==null&&inv.saldoAtual!==undefined) ? Math.max(0,ivNum(inv.saldoAtual)) : atual.saldo;
                const dataFim=inv.vencimento&&inv.vencimento>=today()?inv.vencimento:null;
                const futuro=dataFim?aplicarFluxosFixos(inv,dataFim):null;
                const primeira=movs.find(x=>x.tipo==='aporte');
                const dias=primeira?ivDias(primeira.data,dataFim||today()):0;
                const ir=inv.tributacao==='Isento'?0:inv.tributacao==='IR regressivo'?(dias<=180?.225:dias<=360?.20:dias<=720?.175:.15):null;
                return {valor,principal:atual.principal,recebidos,projetado:futuro,ir,resultado:valor-atual.principal,taxa:taxaEfetivaInv(inv),temCotacao:inv.saldoAtual!==''&&inv.saldoAtual!==null&&inv.saldoAtual!==undefined};
            }
            let qtd=0,custo=0,realizado=0;
            for(const m of movs.filter(x=>x.data<=today())) {
                if(m.tipo==='compra') {let q=ivNum(m.quantidade);if(q>0){custo+=q*ivNum(m.preco)+ivNum(m.taxas);qtd+=q;}}
